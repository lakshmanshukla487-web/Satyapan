APP_ENV=development
# Required when APP_ENV is not "development" (50+ random characters; the app refuses to start otherwise):
# DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Interactive API docs (/docs): always on in development; set to true to publish them elsewhere (not recommended).
# EXPOSE_API_DOCS=false

DATABASE_URL=sqlite:///./satyapan.db
FRONTEND_ORIGIN=http://localhost:5173
# Extra browser origins (LAN testing), comma separated. Must be https:// when APP_ENV is not "development".
# EXTRA_ORIGINS=https://192.168.18.117:5173

# ---- Models: loaded ONCE, on the CPU, when the server starts; after that only inference runs ----
MODEL_DIR=./models
HF_HOME=./model_cache
PRELOAD_MODELS=true
# TORCH_THREADS=4                # 0 = PyTorch decides
INFERENCE_DEVICE=cpu
MAX_CONCURRENT_INFERENCES=2
INFERENCE_QUEUE_LIMIT=8          # more waiting requests than this get a quick "busy" answer instead of a slow page

# Voice anti-spoof: your fine-tuned wav2vec2 in MODEL_DIR/audio (copy model.safetensors there)
ENABLE_AUDIO_DETECTOR=true
# Video deepfake classifier (Apache-2.0 ViT by default): python scripts/download_models.py --video
ENABLE_VIT_DETECTOR=true
VIDEO_MODEL_REPO=prithivMLmods/Deep-Fake-Detector-v2-Model
# Loaded ONCE at server start (with the face detector it crops with: --faces) and only used for inference afterwards.
# VIDEO_FLAG_THRESHOLD=0.7       # a frame counts as flagged at or above this fake probability (uncalibrated)
# VIDEO_CROP_MARGIN=0.25         # square face crop: share of the face size added on every side
# VIDEO_TTA_FLIP=true            # also score the mirrored crop and average (2 inferences per frame)
# VIDEO_MIN_FACE_PX=64           # smaller faces (in the 640 px upload) are not scored: reported as FACE_TOO_SMALL
ENABLE_XCEPTION_DETECTOR=false   # placeholder (not integrated)
# Lip sync (SyncNet; weights are RESEARCH-ONLY): python scripts/download_models.py --syncnet
ENABLE_SYNCNET=true
# Face landmarks (head pose, blinks, eye scan; needs models/face_landmarker.task, already included)
ENABLE_MEDIAPIPE=true
# Face match against the starting photo (OpenCV YuNet + SFace): python scripts/download_models.py --faces
ENABLE_FACEMATCH=true
FACE_COSINE_THRESHOLD=0.363
# Iris scan (close-up eyes). Visible-light webcams give weak evidence; thresholds are NOT calibrated on real data.
ENABLE_EYESCAN=true
IRIS_MATCH_HD=0.32
IRIS_MISMATCH_HD=0.40
IRIS_MIN_VERDICT_PX=80            # smaller irises give "inconclusive", never match/mismatch (40-55 px: barely better than chance on real photos)

ENABLE_INTEGRITY=true            # pipeline integrity: camera (virtual vs hardware) and IP (VPN / proxy / spoofing)
ENABLE_PULSE=true                # pulse (rPPG, supporting evidence only)
ENABLE_PROVENANCE=true           # provenance of uploaded documents (supporting evidence only)
PULSE_MIN_SNR_DB=2.0

# ---- IP / VPN check ----
ENABLE_IP_CHECK=true
IP_DATA_DIR=./data/ip            # fill with:  python scripts/update_ip_lists.py
# IP_REPUTATION_PROVIDER=proxycheck   # or ipqs; needs IP_REPUTATION_API_KEY
# IP_REPUTATION_API_KEY=
# IP_TRUSTED_PROXY_HOPS=1        # number of reverse proxies in front of Django (nginx = 1). 0 = ignore X-Forwarded-For.

# ---- Session workflow ----
REQUIRE_SESSION_APPROVAL=true    # a customer's request goes to an officer first
SESSION_APPROVAL_TIMEOUT_SECONDS=1800
REQUIRE_CHALLENGE_APPROVAL=true  # each challenge waits for an officer (an officer can switch on auto-release per session)
CHALLENGE_AUTO_APPROVE_DEFAULT=false
CHALLENGE_APPROVAL_TIMEOUT_SECONDS=300
CHALLENGE_TTL_SECONDS=60         # how long the customer has once a challenge is released
MIN_SESSION_SECONDS=90           # shorter sessions cannot be GREEN
MIN_CHALLENGES_ANSWERED=3

# ---- Decision policy ----
DECISION_POLICY=v3               # v2 = original demo rules
MIN_POSITIVE_FAMILIES=3
MIN_COVERAGE=0.6
LIVENESS_NEEDS_SERVER=true       # GREEN needs a head turn confirmed by the server's own frames (needs face_landmarker.task)

# 'Say three words' challenge: the phrase is transcribed on the server (Whisper, CPU, in memory only).
# Download once:  python scripts/download_models.py --speech     (about 290 MB, into MODEL_DIR/speech)
ENABLE_SPEECH_CHECK=true
# SPEECH_MODEL_REPO=openai/whisper-base   # whisper-small is more accurate on accents but slower on the CPU

# ---- Live call (officer sees and talks to the customer) ----
ENABLE_LIVE_CALL=true
STUN_URLS=stun:stun.l.google.com:19302
# Behind strict firewalls add a TURN relay (e.g. coturn):
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---- Request rate limits (per minute) ----
# Signed-in accounts are limited PER ACCOUNT (customers behind one LAN / NAT address do not share a bucket); requests without a
# valid sign-in are limited per client address. Sign-in / sign-up keep their own stricter throttle (LOGIN_MAX_ATTEMPTS).
RATE_LIMIT_PER_MINUTE=120              # without a sign-in, per address
RATE_LIMIT_USER_PER_MINUTE=300         # API calls of one signed-in account
RATE_LIMIT_MEDIA_PER_MINUTE=600        # frame / audio / lip-sync / eye-scan / developer-test uploads of one account
RATE_LIMIT_IP_CEILING_PER_MINUTE=3000  # everything from one address together (abuse ceiling)

MAX_UPLOAD_MB=20
MAX_AUDIO_SECONDS=15
MAX_IMAGE_DIMENSION=4096
RETAIN_RAW_MEDIA=false

# KYC documents (uploaded and cross-checked BEFORE the camera and microphone start)
REQUIRE_DOCUMENTS=true
MAX_DOCUMENT_MB=8
ENABLE_DOCUMENT_OCR=true         # only does anything if pytesseract + the Tesseract program are installed

# Accounts
AUTH_TOKEN_TTL_MINUTES=720       # how long a sign-in lasts (signing out ends it immediately)
ALLOW_REGISTRATION=true          # customers may self-register; officers never can
LOGIN_MAX_ATTEMPTS=10            # per IP + username, per 5 minutes

# ---- Redis (optional; recommended for more than one server process or many simultaneous customers) ----
# pip install -r requirements-optional.txt
# REDIS_URL=redis://localhost:6379/0

# Production only (APP_ENV=production):
# SECURE_SSL_REDIRECT=true
# BEHIND_TLS_PROXY=true          # only if a trusted reverse proxy terminates TLS and sets X-Forwarded-Proto
# SECURE_HSTS_SECONDS=31536000

# Evidence sources needed before a session can be GREEN under the old v2 policy only.
# MIN_USABLE_SIGNALS=2

# ---- Developer model test lab (/developer; developer accounts only: python manage.py create_developer <name>) ----
ENABLE_DEVLAB=true
DEVLAB_STORAGE_DIR=./devlab_data       # temporary test uploads (deleted after use); keep outside any public/static folder
# DEVLAB_DATASET_DIR=                  # optional: folder of authorised local datasets (one sub-folder each; real/ fake/ or labels.csv)
DEVLAB_MAX_ITEMS_PER_JOB=200
DEVLAB_MAX_JOB_MB=1000
DEVLAB_MAX_ACTIVE_JOBS=2               # queued + running jobs per developer
DEVLAB_MAX_CONCURRENT_JOBS=1           # jobs run at the same time by one server process
DEVLAB_MAX_VIDEO_SECONDS=120
DEVLAB_MAX_AUDIO_SECONDS=60
DEVLAB_VIDEO_FRAMES=16                 # frames sampled evenly from each test video (at most 64)
DEVLAB_RETENTION_HOURS=24
DEVLAB_LIVE_RESERVE=2                  # model-queue slots always left free for live customer sessions
