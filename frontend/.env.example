# Copied to frontend/.env by start.sh / start.ps1. Everything prefixed VITE_ is visible to anyone who opens the site: no secrets here.
# API and WS base URLs are intentionally empty: Vite proxies /api and /ws to the Django backend on port 8000.
# This avoids mixed-content errors (HTTPS page -> HTTP API) and works at any hostname (localhost or LAN IP).
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
# true = simulated data, no backend needed (the approval workflow, live call and officer actions need the real backend)
VITE_USE_MOCKS=false
